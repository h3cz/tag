# Public browser configuration. Copy this file to .env and replace placeholders.
# Never put service-role keys, provider API keys, or Stripe secrets in VITE_* vars.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: set a public Cloudflare Turnstile site key to enable the challenge.
VITE_TURNSTILE_SITE_KEY=
